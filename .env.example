# Use a provider that supports BOTH image input and tool calling.
# API_BASE_URL must include the provider's API prefix (often /v1).
API_BASE_URL=
API_KEY=
VISION_MODEL=
AGENT_MODEL=
DATA_DIR=data
API_TIMEOUT=90
AGENT_MAX_ROUNDS=4
AUTO_REVIEW=true
# Optional bearer token for all /api endpoints (recommended even locally).
SERVICE_TOKEN=
# PDF compilation is opt-in and requires the isolated Docker image in compiler/.
COMPILE_PDF=false
TEX_IMAGE=note2latex-tex:local

